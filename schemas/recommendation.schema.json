{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weather Advisor Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "intent",
    "summary",
    "recommendations",
    "risks",
    "missing_information"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "needs_clarification",
        "insufficient_evidence"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "weather_lookup",
        "clothing_advice",
        "commute_advice",
        "outdoor_activity",
        "travel_planning",
        "general_weather_advice"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "reason",
          "evidence_ids"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "severity",
          "evidence_ids"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clarification_question": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "clarification_question"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "answered"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "recommendations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
